{
  "$id": "argument",
  "title": "Argument",
  "description": "Un argument utilisé dans le débat. Fichier data/arguments/<id>.md : en-tête YAML + développement en Markdown.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "titre", "type", "camp", "resume", "themes", "statut"],
  "properties": {
    "id": { "$ref": "defs#/definitions/id" },
    "titre": { "type": "string", "minLength": 3 },
    "type": {
      "description": "these : argument positif pour son camp ; objection : attaque contre l'autre camp ; reponse : répond à un ou plusieurs arguments (repond_a obligatoire) ; dilemme : question qui place l'interlocuteur devant des options toutes problématiques.",
      "enum": ["these", "objection", "reponse", "dilemme"]
    },
    "camp": {
      "description": "Qui avance cet argument.",
      "enum": ["christianisme", "islam", "atheisme"]
    },
    "resume": { "type": "string", "minLength": 10 },
    "themes": { "type": "array", "$ref": "defs#/definitions/ids", "minItems": 1 },
    "repond_a": { "$ref": "defs#/definitions/ids" },
    "appuie": { "$ref": "defs#/definitions/ids" },
    "voir_aussi": { "$ref": "defs#/definitions/ids" },
    "passages": { "$ref": "defs#/definitions/ids" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "$ref": "defs#/definitions/id" },
          "localisation": { "type": "string" }
        }
      }
    },
    "premisses": {
      "description": "Étapes du raisonnement. Une prémisse partagée par plusieurs arguments pointe vers l'argument qui la démontre (champ argument).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["enonce"],
        "properties": {
          "enonce": { "type": "string" },
          "argument": { "$ref": "defs#/definitions/id" },
          "passages": { "$ref": "defs#/definitions/ids" }
        }
      }
    },
    "conclusion": { "type": "string" },
    "dilemme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "options"],
      "properties": {
        "question": { "type": "string" },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["si", "alors"],
            "properties": {
              "si": { "type": "string" },
              "alors": { "type": "string" }
            }
          }
        }
      }
    },
    "points_faibles": { "type": "array", "items": { "type": "string" } },
    "statut": { "$ref": "defs#/definitions/statut" },
    "origine": {
      "description": "Documents d'où provient le contenu (chemins dans le Drive), pour la traçabilité.",
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "reponse" } } }, "then": { "required": ["repond_a"], "properties": { "repond_a": { "type": "array", "minItems": 1 } } } },
    { "if": { "properties": { "type": { "const": "dilemme" } } }, "then": { "required": ["dilemme"] } }
  ]
}
